# Groq API key get from console.groq.com (free tier available)
GROQ_API_KEY=gsk_...

# House wallet private key (testnet only, funds the rewards)
# Generate with: offckb account list
# Fund from: https://faucet.nervos.org
HOUSE_PRIVATE_KEY=0x...

# Optional: override testnet RPC
# CKB_TESTNET_RPC=https://testnet.ckb.dev/rpc

# Fiber node RPC for Checkpoint 4/5 verification (optional for now)
# FIBER_NODE_RPC_URL=http://127.0.0.1:8227

# Neon Postgres, backs the landing-page waitlist at /api/waitlist.
# Without it the route returns 500 and nobody can join the list.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Absolute origin used to resolve OG and Twitter card images. Defaults to
# https://ckb-quest.vercel.app; set it if you deploy anywhere else, or links
# will unfurl against the wrong host.
# NEXT_PUBLIC_SITE_URL=https://ckb-quest.vercel.app
